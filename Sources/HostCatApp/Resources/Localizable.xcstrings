    },
    "welcome.point.local.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HostCat does not phone home, upload, or collect any usage data. Configuration and backups stay in your standard user directories."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

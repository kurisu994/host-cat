    "welcome.point.backup.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every real write is preceded by an automatic backup. The latest three are kept by default and can be managed in the backup window."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次真实写入前 HostCat 会自动备份当前 hosts，默认保留最近 3 份，可在备份管理窗口查看与删除。"
          }
        }
      }
    },
    "welcome.point.backup.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatic backups"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入前自动备份"
          }
        }
      }
    },
    "welcome.point.diagnostics.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HostCat uses the macOS unified logging system. Diagnostic logs only land on disk when you explicitly export them; HostCat never uploads them."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HostCat 通过 macOS 系统日志记录关键路径，导出诊断日志只在你主动操作时落盘，HostCat 不会自动上传。"
          }
        }
      }
    },
    "welcome.point.diagnostics.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagnostics stay local"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "诊断日志只在本机"
          }
        }
      }
    },
    "welcome.point.helper.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifying /etc/hosts requires installing a Privileged Helper and approving it in System Settings. The Helper only writes to a fixed hosts path."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改 /etc/hosts 需要安装 Privileged Helper 并在系统设置中审批，Helper 仅允许写入固定的 hosts 路径。"
          }
        }
      }
    },
    "welcome.point.helper.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
